plugin_prometheus:
  url: "http://localhost:8090"
prometheus_server:
  addr: "localhost:9090"
http_server:
  addr: "localhost:8090"
log:
  level: debug
  driver: file    #可选stdout和file。stdout：输出到终端控制台；file：输出到path下的指定文件。
  path: ./log/plugin_prometheus.log
  max_file: 1
  max_size: 10485760
mysql:
  host: localhost
  port: 3306
  user: ''
  password: ''
  database: PluginPrometheus
etcd:
  endpoints:
    - "localhost:2379"
  service_name: "prometheus-service"
  version: "3.0"
  dialTimeout: 5s
  menu_name: "监控告警"
  icon: "Odometer"